    <!--  Dialog stages  -->
    <system:String x:Key="Str.Stages.CheckPyModules">Comprobando los módulos instalados...</system:String>
    <system:String x:Key="Str.Stages.PyModulesQuestion" xml:space="preserve">Faltan módulos de Python necesarios. ¿Quieres instalarlos ahora?&#13;¡Solo está disponible para tarjetas gráficas NVIDIA!</system:String>
    <system:String x:Key="Str.Stages.PyModulesQuestion2" xml:space="preserve">Los módulos ocupan unos 5 GB de disco.&#13;La instalación puede tardar desde unos minutos hasta una hora.&#13;¿Quieres continuar?</system:String>
    <system:String x:Key="Str.Stages.InstallationPyModule1">(1/3) Instalando el módulo 'pytorch'...</system:String>
    <system:String x:Key="Str.Stages.InstallationPyModule2">(2/3) Instalando el módulo 'easyocr'...</system:String>
    <system:String x:Key="Str.Stages.InstallationPyModule3">(3/3) Instalando el módulo 'pillow'...</system:String>
    <system:String x:Key="Str.Stages.InstallationPyModuleTemplate">Instalando el módulo '{0}'...</system:String>
