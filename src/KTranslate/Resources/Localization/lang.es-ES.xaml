    <system:String x:Key="Str.ProxySettings.Proxy">Proxy</system:String>
    <system:String x:Key="Str.ProxySettings.IpAddress">Dirección IP</system:String>
    <system:String x:Key="Str.ProxySettings.Port">Puerto</system:String>
