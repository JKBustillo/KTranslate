<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!--  Generic  -->
    <system:String x:Key="Str.Login">Usuario</system:String>
    <system:String x:Key="Str.Password">Contraseña</system:String>
    <system:String x:Key="Str.ExitConfirmation" xml:space="preserve">¿Quieres cerrar la aplicación?&#13;Puedes usar el botón de minimizar para ocultar los ajustes (la app seguirá disponible en el icono de la bandeja).</system:String>
    <system:String x:Key="Str.ExitConfirmationCaption">Confirmar salida</system:String>
    <system:String x:Key="Str.NewVersion">¡Hay una versión nueva!</system:String>

    <!--  Notifications  -->
    <system:String x:Key="Str.Notification.CaptchaPass" xml:space="preserve">Completa el captcha en la web para poder usar el servicio.&#13;Puede hacer falta hacerlo con cada proxy configurado.</system:String>

    <!--  Titles  -->
    <system:String x:Key="Str.Title.SettingWindow" xml:space="preserve">Ajustes - KTranslate</system:String>
    <system:String x:Key="Str.Title.BrowserWindow" xml:space="preserve">Navegador - KTranslate</system:String>

    <!--  Tray  -->
    <system:String x:Key="Str.Tray.ShowHideSettings">Mostrar u ocultar los ajustes</system:String>
    <system:String x:Key="Str.Tray.ShowHideTranslation">Mostrar u ocultar la traducción</system:String>
    <system:String x:Key="Str.Tray.Exit">Salir</system:String>

    <!--  Chat  -->
    <system:String x:Key="Str.Chat.SettingsOpened">Cierra los ajustes para empezar a traducir</system:String>
    <system:String x:Key="Str.Chat.WindowLocked">Ventana de traducción bloqueada</system:String>
    <system:String x:Key="Str.Chat.WindowUnlocked">Ventana de traducción desbloqueada</system:String>

