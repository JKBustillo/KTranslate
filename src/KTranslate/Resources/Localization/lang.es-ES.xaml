    <system:String x:Key="Str.LangSettings.Translator">Traductor</system:String>
    <system:String x:Key="Str.LangSettings.TtsSystem">Sistema de voz</system:String>

    <!--  Hotkeys descriptions  -->
    <system:String x:Key="Str.Hotkeys.ChatVisibility">Mostrar u ocultar la ventana de traducción</system:String>
    <system:String x:Key="Str.Hotkeys.SettingsVisibility">Abrir o cerrar los ajustes</system:String>
    <system:String x:Key="Str.Hotkeys.SelectArea">Seleccionar el área de captura</system:String>
