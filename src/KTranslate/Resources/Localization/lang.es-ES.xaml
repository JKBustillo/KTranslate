    <system:String x:Key="Str.ProxySettings.Caption">Lista de proxies — cambiar</system:String>


    <!--  OCR settings  -->
    <system:String x:Key="Str.OcrSettings.TesseractOcr">Tesseract OCR</system:String>
    <system:String x:Key="Str.OcrSettings.WindowsOcr">Windows OCR</system:String>
    <system:String x:Key="Str.OcrSettings.EasyOcr">EasyOCR</system:String>
    <system:String x:Key="Str.OcrSettings.TesseractOcrDesc" xml:space="preserve">Tesseract 5.0 en modo LSTM. Una de las primeras soluciones de OCR libres y de las más conocidas.&#13;Reconoce bien el texto sobre fondos lisos y sencillos.&#13;&lt;Bold&gt;Impacto en el rendimiento:&lt;/Bold&gt; bajo</system:String>
    <system:String x:Key="Str.OcrSettings.WindowsOcrDesc" xml:space="preserve">Solución de OCR propia de Microsoft. Se defiende mejor que Tesseract con fondos complicados.&#13;&lt;Bold&gt;Impacto en el rendimiento:&lt;/Bold&gt; mínimo</system:String>
    <system:String x:Key="Str.OcrSettings.WindowsOcrDesc2">Puede que haya que instalar paquetes de idioma adicionales</system:String>
    <system:String x:Key="Str.OcrSettings.EasyOcrDesc" xml:space="preserve">La solución de OCR libre más avanzada, de Jaided AI.&#13;Gran precisión incluso con fondos complicados y tipografías poco corrientes.&#13;&lt;Bold&gt;Impacto en el rendimiento:&lt;/Bold&gt; alto</system:String>
    <system:String x:Key="Str.OcrSettings.EasyOcrDesc2">Hay que instalar paquetes adicionales (Python, PyTorch)</system:String>

    <!--  About window  -->
    <system:String x:Key="Str.About.MaintainedBy">Propietario y responsable: Aleksei Vekhov</system:String>
