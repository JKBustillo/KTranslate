<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  App palette  -->
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#fbffff" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#c7f7ff" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#95c4cc" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#000000" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#fbffff" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#c7ffea" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#95ccb8" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="#000000" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#f03a16" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#ebf5f7" />
    <SolidColorBrush x:Key="WarningBrush" Color="#ffdad6" />

    <!--  Semantic keys: the hue brushes above are control fills, these are the surfaces and text that must not follow them  -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#95c4cc" />
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#fbffff" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#95c4cc" />
    <!--  the selected nav item blends into the content panel, so its background matches it  -->
    <SolidColorBrush x:Key="SidebarSelectionBackgroundBrush" Color="#fbffff" />
    <SolidColorBrush x:Key="SidebarSelectionForegroundBrush" Color="#2b3a3d" />

    <!--  Material Design keys the built-in control templates look up at runtime  -->
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="#ffffff" />
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#ffffff" />
    <SolidColorBrush x:Key="MaterialDesignBackground" Color="#ffffff" />
    <SolidColorBrush x:Key="MaterialDesignToolBackground" Color="#f5f5f5" />
    <SolidColorBrush x:Key="MaterialDesignBody" Color="#dd000000" />
    <SolidColorBrush x:Key="MaterialDesignBodyLight" Color="#89000000" />
    <SolidColorBrush x:Key="MaterialDesignColumnHeader" Color="#89000000" />
    <SolidColorBrush x:Key="MaterialDesignDivider" Color="#1f000000" />
    <SolidColorBrush x:Key="MaterialDesignTextBoxBorder" Color="#89000000" />
    <SolidColorBrush x:Key="MaterialDesignTextAreaBorder" Color="#89000000" />
    <SolidColorBrush x:Key="MaterialDesignCheckBoxOff" Color="#89000000" />
    <SolidColorBrush x:Key="MaterialDesignSelection" Color="#cccccc" />
    <SolidColorBrush x:Key="MaterialDesignFlatButtonClick" Color="#cccccc" />
</ResourceDictionary>
