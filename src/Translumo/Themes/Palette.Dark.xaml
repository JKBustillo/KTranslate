<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  App palette  -->
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#232a31" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#e6edf3" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#26c6da" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#0b1013" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#1f8f9e" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#e6edf3" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#1b1f24" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="#e6edf3" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#26c6da" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="#0b1013" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#7fd8c9" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="#e6edf3" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#ff6b52" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2a323a" />
    <SolidColorBrush x:Key="WarningBrush" Color="#7a4f45" />

    <!--  Semantic keys: the hue brushes above are control fills, these are the surfaces and text that must not follow them  -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#12161a" />
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#e6edf3" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4dd0e1" />
    <!--  the selected nav item blends into the content panel, so its background matches it  -->
    <SolidColorBrush x:Key="SidebarSelectionBackgroundBrush" Color="#1b1f24" />
    <SolidColorBrush x:Key="SidebarSelectionForegroundBrush" Color="#e6edf3" />

    <!--  Material Design keys the built-in control templates look up at runtime  -->
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="#1b1f24" />
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#232a31" />
    <SolidColorBrush x:Key="MaterialDesignBackground" Color="#1b1f24" />
    <SolidColorBrush x:Key="MaterialDesignToolBackground" Color="#232a31" />
    <SolidColorBrush x:Key="MaterialDesignBody" Color="#e6edf3" />
    <SolidColorBrush x:Key="MaterialDesignBodyLight" Color="#9aa7b2" />
    <SolidColorBrush x:Key="MaterialDesignColumnHeader" Color="#9aa7b2" />
    <SolidColorBrush x:Key="MaterialDesignDivider" Color="#2f373f" />
    <SolidColorBrush x:Key="MaterialDesignTextBoxBorder" Color="#55606b" />
    <SolidColorBrush x:Key="MaterialDesignTextAreaBorder" Color="#55606b" />
    <SolidColorBrush x:Key="MaterialDesignCheckBoxOff" Color="#9aa7b2" />
    <SolidColorBrush x:Key="MaterialDesignSelection" Color="#2a323a" />
    <SolidColorBrush x:Key="MaterialDesignFlatButtonClick" Color="#2a323a" />
</ResourceDictionary>
